# === Segurança do gateway ===
# Chaves que os clientes OpenAI usam no Authorization: Bearer (separadas por vírgula).
# VAZIO = gateway aberto (somente dev!).
GATEWAY_API_KEYS=troque-esta-chave

# Chave para os endpoints administrativos (/auth/*, /config/*).
# Vazio = usa as GATEWAY_API_KEYS.
ADMIN_API_KEY=troque-esta-chave-admin

# === Modelos ===
DEFAULT_MODEL=sonnet
# true = modelo desconhecido vira erro 404; false = cai no DEFAULT_MODEL (compatibilidade
# com clientes que hardcodam gpt-*).
MODEL_STRICT=false

# === Robustez ===
MAX_CONCURRENCY=3
REQUEST_TIMEOUT_SECONDS=300

# === Modo agente (ferramentas: Bash, arquivos, etc.) ===
AGENT_MODE_ENABLED=false
AGENT_ROOT=/workspace
AGENT_DEFAULT_PERMISSION_MODE=bypassPermissions
AGENT_MAX_TURNS=30
# MAX_BUDGET_USD_PER_REQUEST=1.0

# === Diversos ===
# DATA_DIR=/data          # já definido na imagem Docker
# CLAUDE_CLI_PATH=        # caminho de um CLI específico (por padrão usa o embutido no SDK)
# CORS_ORIGINS=
LOG_LEVEL=info
